<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#09A1FF"
    android:gravity=""
    android:padding="16dp">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Tentukan Lubang \n Venturi motor"
        android:textColor="@color/black"
        android:textAlignment="center"
        android:textStyle="bold|italic"
        android:textSize="35dp"
        android:layout_gravity="center"
        android:layout_marginTop="25dp"
        android:layout_marginBottom="50dp"/>

    <TextView
        android:layout_marginTop="50dp"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:textStyle="italic"
        android:text="Konstanta (K)(0.6-0.9)"
        android:textColor="#FFFFFF"
        android:layout_marginBottom="5dp"/>

    <EditText
        android:id="@+id/konsta"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:inputType="numberDecimal"
        android:padding="10dp"
        android:background="@android:drawable/edit_text"
        android:layout_marginBottom="10dp"
        android:hint="Masukkan Konstanta (k)(0.6-0.9)"/>

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="CC Mesin (C)(liter)"
        android:textColor="#FFFFFF"
        android:textStyle="italic"
        android:layout_marginBottom="5dp"/>

    <EditText
        android:id="@+id/CCmesin"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:inputType="numberDecimal"
        android:padding="10dp"
        android:background="@android:drawable/edit_text"
        android:layout_marginBottom="10dp"
        android:hint="Masukkan CC Mesin (C)(liter)"/>

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="RPM Puncak Tenaga (N)"
        android:textColor="#FFFFFF"
        android:textStyle="italic"
        android:layout_marginBottom="5dp"/>

    <EditText
        android:id="@+id/RPM"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:inputType="number"
        android:padding="10dp"
        android:background="@android:drawable/edit_text"
        android:layout_marginBottom="10dp"
        android:hint="Masukkan RPM Puncak Tenaga (N)"/>

    <!-- Button for Calculation -->
    <Button
        android:layout_gravity="center"
        android:id="@+id/calculateButton"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:backgroundTint="#00ff00"
        android:text="KALKULASI"
        android:textColor="#FFFFFF"
        android:layout_marginTop="20dp"/>

    <!-- Result Section -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:background="#FFFFFF"
        android:padding="20dp"
        android:layout_marginTop="20dp"
        android:layout_gravity="center"
        android:gravity="center"
        android:radius="5dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="HASIL :"
            android:textColor="#000000"
            android:textStyle="bold"/>

        <TextView
            android:id="@+id/output"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="#000000"
            android:layout_marginTop="10dp"/>
    </LinearLayout>
</LinearLayout>
